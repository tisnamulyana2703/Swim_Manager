rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Default deny unknown collections
    match /{document=**} {
      allow read, write: if false;
    }

    match /championships/{championshipId} {
      allow read, write: if isValidId(championshipId);
    }

    match /clubs/{clubId} {
      allow read, write: if isValidId(clubId);
    }

    match /athletes/{athleteId} {
      allow read, write: if isValidId(athleteId);
    }

    match /events/{eventId} {
      allow read, write: if isValidId(eventId);
    }

    match /incidents/{incidentId} {
      allow read, write: if isValidId(incidentId);
    }

    match /officialMinutes/{minutesId} {
      allow read, write: if isValidId(minutesId);
    }

    match /settings/{settingId} {
      allow read, write: if isValidId(settingId);
    }
  }
}
