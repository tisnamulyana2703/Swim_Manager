rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Default deny all unknown collections
    match /{document=**} {
      allow read, write: if false;
    }

    match /championships/{championshipId} {
      allow read: if true;
      allow write: if isSignedIn() && isValidId(championshipId);
    }

    match /clubs/{clubId} {
      allow read: if true;
      allow write: if isSignedIn() && isValidId(clubId);
    }

    match /athletes/{athleteId} {
      allow read: if true;
      allow write: if isSignedIn() && isValidId(athleteId);
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if isSignedIn() && isValidId(eventId);
    }

    match /incidents/{incidentId} {
      allow read: if true;
      allow write: if isSignedIn() && isValidId(incidentId);
    }

    match /officialMinutes/{minutesId} {
      allow read: if true;
      allow write: if isSignedIn() && isValidId(minutesId);
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSignedIn() && isValidId(settingId);
    }
  }
}
